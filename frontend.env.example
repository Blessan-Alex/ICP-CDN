# Frontend Environment Configuration
# Copy this file to src/icp_cdn_frontend/.env and fill in your values

# DFX Configuration
VITE_DFX_REPLICA_HOST=http://127.0.0.1:4943
VITE_DFX_NETWORK=local

# Pinata Configuration (Optional - for direct frontend uploads)
# Note: For security, Pinata uploads should go through the backend
# These are only used for frontend display/informational purposes
VITE_PINATA_GATEWAY=gateway.pinata.cloud

# Upload Configuration
VITE_MAX_FILE_SIZE_MB=50
VITE_UPLOAD_CHUNK_SIZE_KB=1024

# Feature Flags
VITE_ENABLE_DEBUG_LOGS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Cache Configuration (for frontend display)
VITE_MAX_CACHE_ITEMS=1000
VITE_MAX_CACHE_SIZE_MB=20
VITE_FREE_TIER_CACHE_LIMIT_MB=20
VITE_STARTER_TIER_CACHE_LIMIT_MB=50
VITE_PRO_TIER_CACHE_LIMIT_MB=100
VITE_BUSINESS_TIER_CACHE_LIMIT_MB=500

# Pricing Configuration (for frontend display)
VITE_STARTER_UPGRADE_COST_CYCLES=1000000000
VITE_PRO_UPGRADE_COST_CYCLES=5000000000
VITE_BUSINESS_UPGRADE_COST_CYCLES=15000000000

# Frontend Environment Configuration
# Copy this file to src/icp_cdn_frontend/.env and fill in your values

# DFX Configuration
VITE_DFX_REPLICA_HOST=http://127.0.0.1:4943
VITE_DFX_NETWORK=local

# Pinata Configuration (Optional - for direct frontend uploads)
# Note: For security, Pinata uploads should go through the backend
# These are only used for frontend display/informational purposes
VITE_PINATA_GATEWAY=gateway.pinata.cloud

# Upload Configuration
VITE_MAX_FILE_SIZE_MB=50
VITE_UPLOAD_CHUNK_SIZE_KB=1024

# Feature Flags
VITE_ENABLE_DEBUG_LOGS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
